# ComfyUI must stay on the same server and listen only on loopback.
COMFYUI_URL=http://127.0.0.1:8188

# Generate a unique secret, for example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The bridge refuses to start with this placeholder or with a short token.
COMFY_BRIDGE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Keep this loopback-only when a reverse proxy, SSH tunnel, or Tailscale serves clients.
COMFY_BRIDGE_BIND=127.0.0.1
COMFY_BRIDGE_PORT=8787

# Start with mock. It exercises upload, job, polling, and download without contacting ComfyUI.
# Change to live only after an exported ComfyUI API workflow has replaced an example preset.
COMFY_BRIDGE_MODE=mock

# Optional operational limits. Values are bytes except the timeouts and worker count.
COMFY_BRIDGE_MAX_UPLOAD_BYTES=67108864
# Keep this aligned with the local workbench's per-output verification limit.
COMFY_BRIDGE_MAX_OUTPUT_BYTES=2147483648
COMFY_BRIDGE_REQUEST_TIMEOUT_SECONDS=30
COMFY_BRIDGE_EXECUTION_TIMEOUT_SECONDS=7200
COMFY_BRIDGE_POLL_SECONDS=2
COMFY_BRIDGE_WORKERS=1
