{
  "id": "image-to-image",
  "name": "FLUX.2 Klein 4B 多参考生图",
  "kind": "image",
  "description": "调用 api-workflows/image-to-image.api.json。使用 FLUX.2 Klein 4B 的独立 ReferenceLatent 条件进行一张或两张参考图生成，不混合参考图 latent。",
  "enabled": true,
  "comfyPromptFile": "image-to-image.api.json",
  "inputMappings": {
    "prompt": {
      "nodeId": "92:109",
      "field": "text",
      "type": "string",
      "required": true,
      "maxLength": 20000,
      "description": "正向提示词"
    },
    "width": {
      "nodeId": "92:102",
      "field": "width",
      "targets": [
        { "nodeId": "92:102", "field": "width" },
        { "nodeId": "92:113", "field": "width" }
      ],
      "type": "integer",
      "required": false,
      "min": 256,
      "max": 2048,
      "description": "输出分辨率宽度"
    },
    "height": {
      "nodeId": "92:102",
      "field": "height",
      "targets": [
        { "nodeId": "92:102", "field": "height" },
        { "nodeId": "92:113", "field": "height" }
      ],
      "type": "integer",
      "required": false,
      "min": 256,
      "max": 2048,
      "description": "输出分辨率高度"
    },
    "seed": {
      "nodeId": "92:106",
      "field": "noise_seed",
      "type": "integer",
      "required": false,
      "min": 0,
      "max": 9007199254740991,
      "description": "随机种子"
    }
  },
  "uploadMappings": {
    "referenceImage": {
      "nodeId": "76",
      "field": "image",
      "required": true,
      "acceptedExtensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "description": "第一张参考图；注入 LoadImage 节点 76"
    },
    "referenceImage2": {
      "nodeId": "81",
      "field": "image",
      "required": false,
      "fallbackRole": "referenceImage",
      "acceptedExtensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "description": "可选第二张参考图；缺省时复用第一张参考图"
    }
  },
  "outputNodeIds": [
    "94"
  ]
}
