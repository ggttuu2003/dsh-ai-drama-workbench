{
  "id": "image-generate-qwen",
  "name": "Qwen Image 2512 文生图",
  "kind": "image",
  "description": "Qwen Image 2512 Base 文生图，使用固定的质量优先采样参数。",
  "enabled": true,
  "model": {
    "id": "qwen-image-2512",
    "label": "Qwen Image 2512",
    "presetIds": [
      "character-turnaround-v1",
      "scene-image-v1",
      "prop-image-v1",
      "shot-image-v1",
      "shot-first-frame-v1",
      "shot-last-frame-v1"
    ],
    "requirements": [
      { "nodeId": "248", "field": "unet_name" },
      { "nodeId": "245", "field": "clip_name" },
      { "nodeId": "246", "field": "vae_name" }
