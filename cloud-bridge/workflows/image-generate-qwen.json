  },
  "comfyPromptFile": "image-generate-qwen.api.json",
  "inputMappings": {
    "prompt": {
      "nodeId": "249",
      "field": "text",
      "type": "string",
      "required": true,
      "maxLength": 20000,
      "description": "正向提示词"
    },
    "negativePrompt": {
      "nodeId": "250",
      "field": "text",
      "type": "string",
      "required": false,
      "maxLength": 20000,
      "description": "负向提示词"
    },
    "width": {
      "nodeId": "252",
      "field": "width",
      "type": "integer",
      "required": false,
      "min": 256,
      "max": 2048,
      "description": "输出宽度"
    },
    "height": {
      "nodeId": "252",
      "field": "height",
      "type": "integer",
      "required": false,
      "min": 256,
      "max": 2048,
      "description": "输出高度"
    },
    "seed": {
      "nodeId": "253",
      "field": "seed",
      "type": "integer",
      "required": false,
      "min": 0,
      "max": 9007199254740991,
      "description": "随机种子"
    }
  },
  "uploadMappings": {},
  "outputNodeIds": [
    "254"
  ]
}
