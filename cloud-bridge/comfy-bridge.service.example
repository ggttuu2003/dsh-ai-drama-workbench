[Unit]
Description=Comfy Bridge for AI Drama Workbench
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=/opt/comfy-bridge
EnvironmentFile=/opt/comfy-bridge/.env
ExecStart=/usr/bin/python3 /opt/comfy-bridge/bridge.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
